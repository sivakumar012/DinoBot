{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "Runs the full Vitest test suite (unit + property) after each spec task completes, so you always know if a task broke something.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest run"
  }
}