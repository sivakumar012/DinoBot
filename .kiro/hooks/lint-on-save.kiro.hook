{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs ESLint on TypeScript source and test files whenever they are saved.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint"
  }
}